# TYPO3 Instance
TYPO3_BASE_URL=https://your-typo3-instance.example.com
TYPO3_MCP_URL=
TYPO3_MCP_ACCESS_TOKEN=
TYPO3_LOCAL_USER_NAME=Local TYPO3 Token
TYPO3_OAUTH_CLIENT_ID=
TYPO3_OAUTH_CLIENT_SECRET=
TYPO3_MCP_SYSTEM_PROMPT=

# OAuth mode:
# - set TYPO3_OAUTH_CLIENT_ID and TYPO3_OAUTH_CLIENT_SECRET
# - leave TYPO3_MCP_URL and TYPO3_MCP_ACCESS_TOKEN empty
#
# Token-based MCP mode:
# - set TYPO3_MCP_URL to the full TYPO3 MCP URL, including ?token=...
# - or set TYPO3_MCP_ACCESS_TOKEN if your MCP setup uses a raw bearer token
# - leave TYPO3_OAUTH_CLIENT_ID and TYPO3_OAUTH_CLIENT_SECRET empty

# OpenAI
OPENAI_API_KEY=

# Security
# ENCRYPTION_KEY: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ENCRYPTION_KEY=
SESSION_SECRET=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
